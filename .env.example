# === .env reference ===
#
# You normally do NOT create this by hand. The build scripts generate .env:
#
#   ./build/build-basic.sh          # released gateway (compose)  -> GATEWAY_IMAGE
#   ./build/build-experimental.sh   # experimental-ratelimit (host) -> GATEWAY_BIN
#
# The two builds run differently, so they write different variables:
#   * BASIC runs in docker compose and sets GATEWAY_IMAGE / PRAXIS_CONFIG /
#     PRAXIS_POLICY_CONFIG_PATH; `make deploy-gateway` brings it up.
#   * EXPERIMENTAL runs a host binary and sets GATEWAY_BIN / PRAXIS_CONFIG;
#     `make run-experimental` runs it (compose only hosts the supporting services).
#
# docker compose has sane defaults for the compose variables, so it runs even
# without a .env. This file documents the variables the scripts write.

# --- BASIC build (docker compose) ---
# Gateway image to run (set by ./build/build-basic.sh).
GATEWAY_IMAGE=praxis-gateway:basic
# Policy document mounted at /etc/praxis/policy.yaml (basic points at a harmless
# placeholder with no policy doc).
PRAXIS_POLICY_CONFIG_PATH=./config/praxis/basic.yaml

# --- EXPERIMENTAL build (host binary) ---
# Absolute path to the host-compiled binary (set by ./build/build-experimental.sh).
# GATEWAY_BIN=/abs/path/to/praxis-ai/target/release/praxis-ai

# --- Shared ---
# Active runtime config (dispatches `make test`):
#   basic.yaml                (basic)
#   ratelimit-limitador.yaml  (experimental)
PRAXIS_CONFIG=basic.yaml

# Logging level: trace | debug | info | warn | error
RUST_LOG=info

# === Upstream service image versions ===
INFERENCE_SIM_VERSION=v0.1.1
MOCKSERVER_VERSION=8.0.0
