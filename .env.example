# === .env reference ===
#
# You normally do NOT create this by hand. The build scripts generate .env:
#
#   ./build/build-basic.sh          # released gateway  -> praxis-gateway:basic
#   ./build/build-experimental.sh   # experimental-ratelimit -> praxis-gateway:experimental
#
# docker compose also has sane defaults for every variable below, so it runs
# even without a .env. This file documents the variables the scripts write.

# Gateway image to run (set by the build scripts).
#   praxis-gateway:basic         (from ./build/build-basic.sh)
#   praxis-gateway:experimental  (from ./build/build-experimental.sh)
GATEWAY_IMAGE=praxis-gateway:basic

# Runtime config mounted at /etc/praxis/praxis-ai.yaml
#   basic.yaml                (basic)
#   ratelimit-limitador.yaml  (experimental)
PRAXIS_CONFIG=basic.yaml

# Policy document mounted at /etc/praxis/policy.yaml
#   basic:        points at basic.yaml (harmless placeholder, no policy doc)
#   experimental: ./config/praxis/ratelimit-policy.yaml
PRAXIS_POLICY_CONFIG_PATH=./config/praxis/basic.yaml

# Logging level: trace | debug | info | warn | error
RUST_LOG=info

# === Upstream service image versions ===
INFERENCE_SIM_VERSION=v0.1.1
MOCKSERVER_VERSION=8.0.0
