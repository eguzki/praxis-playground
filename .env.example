# === Build Configuration ===

# Features to enable (comma-separated)
# Options: full, token-rate-limit-filter, experimental-ratelimit
# - full: Base Praxis AI features
# - token-rate-limit-filter: Native token rate limiting
# - experimental-ratelimit: PPE ratelimit/limitador plugin (embedded)
PRAXIS_FEATURES=full,token-rate-limit-filter

# Source specifications for each layer:
#   crate:VERSION    - Use published crate (e.g., crate:0.7.5)
#   git:REF          - Clone from GitHub (e.g., git:main, git:v0.1.0, git:abc123)
#   path:PATH        - Use local checkout (e.g., path:/workspace/ai)
PRAXIS_AI_SOURCE=git:main
PRAXIS_CORE_SOURCE=crate:0.7.5
PRAXIS_POLICY_SOURCE=crate:0.4.1

# Apply experimental patches (true|false)
APPLY_RATELIMIT_PATCHES=false   # Vendor policy main + core v0.7.5, apply #1478 patches

# === Runtime Configuration ===

# Config file to mount from config/praxis/
# Options: token-rate-limit.yaml, rate-limit.yaml, ratelimit-limitador.yaml
PRAXIS_CONFIG=token-rate-limit.yaml

# Policy file for PPE-based configs (path relative to config/praxis/, or empty for native filters)
# Set to ratelimit-policy.yaml when using the ratelimit plugin
PRAXIS_POLICY_CONFIG=

# Helper: full path for docker-compose volume mount (leave as-is)
PRAXIS_POLICY_CONFIG_PATH=./config/praxis/${PRAXIS_POLICY_CONFIG:-token-rate-limit.yaml}

# Logging level for Praxis gateway
# Options: trace, debug, info, warn, error
RUST_LOG=info

# === Service Versions ===

# Upstream service image versions
INFERENCE_SIM_VERSION=v0.1.1
MOCKSERVER_VERSION=8.0.0

# === Configuration Examples ===

# Token rate limiting (default, recommended)
# Native filter with reserve→reconcile, weighted tokens, M1-M7 verified
# PRAXIS_FEATURES=full,token-rate-limit-filter
# PRAXIS_CONFIG=token-rate-limit.yaml
# PRAXIS_POLICY_CONFIG=
# APPLY_RATELIMIT_PATCHES=false

# Request-count rate limiting
# Simple request-count limiting (not token-based)
# PRAXIS_FEATURES=full
# PRAXIS_CONFIG=rate-limit.yaml
# PRAXIS_POLICY_CONFIG=
# APPLY_RATELIMIT_PATCHES=false

# Ratelimit plugin with embedded Limitador
# PPE plugin with request-count limiting, in-memory Limitador
# PRAXIS_FEATURES=full,experimental-ratelimit
# PRAXIS_CONFIG=ratelimit-limitador.yaml
# PRAXIS_POLICY_CONFIG=ratelimit-policy.yaml
# APPLY_RATELIMIT_PATCHES=true
