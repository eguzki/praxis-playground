# === Build Configuration for Experimental-Ratelimit ===
#
# This configuration enables the experimental-ratelimit feature (PPE plugin with
# embedded Limitador). To use this configuration:
#
#   cp .env.ratelimit-limitador .env
#   make gateway        # Build with patches (5-10 min)
#   make deploy-gateway # Deploy
#   ./test/test-ratelimit-limitador.sh  # Test
#

# Features to enable (comma-separated)
# experimental-ratelimit: PPE ratelimit/limitador plugin (embedded)
PRAXIS_FEATURES=full,experimental-ratelimit

# Source specifications for each layer
PRAXIS_AI_SOURCE=git:main
PRAXIS_CORE_SOURCE=crate:0.7.5
PRAXIS_POLICY_SOURCE=crate:0.4.1

# Apply experimental patches (REQUIRED for experimental-ratelimit)
# This vendors policy main + core v0.7.5 and applies #1478 host wiring
APPLY_RATELIMIT_PATCHES=true

# === Runtime Configuration ===

# Config file: ratelimit-limitador.yaml (PPE plugin)
PRAXIS_CONFIG=ratelimit-limitador.yaml

# Policy file: required for PPE-based configs
PRAXIS_POLICY_CONFIG=ratelimit-policy.yaml

# Helper: full path for docker-compose volume mount (leave as-is)
PRAXIS_POLICY_CONFIG_PATH=./config/praxis/${PRAXIS_POLICY_CONFIG:-token-rate-limit.yaml}

# Logging level for Praxis gateway
RUST_LOG=info

# === Service Versions ===

# Upstream service image versions
INFERENCE_SIM_VERSION=v0.1.1
MOCKSERVER_VERSION=8.0.0

# === Feature Details ===
#
# This configuration provides:
#   - Request-count rate limiting (not token-based)
#   - Embedded in-memory Limitador (no external service)
#   - JWT-based tier budgets: gold (5/60s), silver (2/60s), basic (3/60s)
#   - Enterprise exemption (no matching limit)
#   - M1 + M5 acceptance criteria verified
#   - HTTP 429 on over-budget
#
# Build time: ~5-10 minutes (vendoring + patching + compilation)
# Image size: ~194MB
#
# Differences from token-rate-limit.yaml:
#   ✓ Request-count only (not token-denominated)
#   ✗ No model-keyed budgets (runs pre-body)
#   ✗ No reserve→reconcile
#   ✗ No X-RateLimit-* headers
#   ✗ No M2/M3/M4 (token-specific features)
